{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Memora",
  "version": "0.4.0",
  "identifier": "com.memora.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../ui", "wait": false },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../ui" }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Memora",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": false,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://localhost:5173; img-src 'self' data: blob: http://127.0.0.1:*; media-src 'self' blob: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Memora",
    "copyright": "Copyright (c) Akash Bose. MIT License.",
    "category": "Photography",
    "shortDescription": "Offline photo and video library",
    "longDescription": "Memora is an offline, local-first photo and video library for Windows, with TV streaming on your home network.",
    "licenseFile": "../LICENSE",
    "windows": {
      "digestAlgorithm": "sha256",
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "installer-hooks.nsh",
        "installerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
